APP__TITLE="TransferCove"
APP__DESCRIPTION="Application for sharing files over a local network"
APP__VERSION=0.3.0
APP__DEBUG=False

UVICORN__HOST=127.0.0.1
UVICORN__PORT=8000
UVICORN__LOG_LEVEL=info
UVICORN__RELOAD=False

TRANSMITTER__STORAGE_DIR=.data/files
TRANSMITTER__DATABASE_URL=sqlite+aiosqlite:///./.data/files.db

# Standalone server limits; saved desktop preferences take precedence in the UI.
UPLOAD_LIMITS__MAX_FILE_MIB=1024
UPLOAD_LIMITS__MAX_CONCURRENT=2
UPLOAD_LIMITS__RESERVE_MIB=512
UPLOAD_LIMITS__IDLE_TIMEOUT_SECONDS=60

DESKTOP__LANGUAGE=en
DESKTOP__AUTO_START=False
DESKTOP__OPEN_BROWSER=True
